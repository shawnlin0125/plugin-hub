# Dockerfile.heavy-1 — TicketMaster plugin only
FROM python:3.12-slim

WORKDIR /app

# Install platform SDK
COPY platform-plugin-sdk/ /app/sdk/
RUN pip install /app/sdk/

# Install platform core
COPY platform/ /app/platform/
RUN pip install fastapi uvicorn pyyaml

# Install ticket-vendor plugins
ARG TICKET_VERSION=main
RUN pip install git+https://github.com/shawnlin0125/ticket-vendor.git@${TICKET_VERSION}

ENV LOAD_PLUGINS="ticketmaster"
EXPOSE 8000

CMD ["python", "-m", "platform.main"]
